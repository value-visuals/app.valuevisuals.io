# Firebase web app config (public identifiers; not service-account secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Keep existing API routes pointing to the existing backend. Server-only HTTPS URLs.
PROD_API_URL=https://api.valuevisuals.io
# Optional local backend for development (LOCAL_TESTING=true)
LOCAL_TESTING=false
TEST_API_URL=http://localhost:3001

# Optional: only for exported mobile bundles; hosted Next.js app with /api/* routes.
# NEXT_PUBLIC_API_PROXY_ORIGIN=https://app.valuevisuals.io
